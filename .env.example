# =============================================================================
# EventPilot configuration. Copy to .env and fill in. NEVER commit .env.
#
# Fastest path (cross-platform):  python -m scripts.init_env
# That command creates .env with unique seeds, the RSVP secret and the two
# peer addresses already filled in. Edit .env by hand only if you prefer.
# =============================================================================

APP_ENV=development
DATABASE_DIR=./data
LOG_LEVEL=INFO

# --- Agent identities (REQUIRED) --------------------------------------------
# Each agent MUST have its own unique seed. Changing a seed changes that
# agent's address, so re-run scripts.print_addresses and re-register it.
# Generate one value: python -c "import secrets; print(secrets.token_hex(24))"
COORDINATOR_SEED=
SUPPLIER_SEED=
OUTREACH_SEED=

# Port used by the agent process started with this environment.
# scripts/run_local.py overrides it per agent (8101/8102/8103).
AGENT_PORT=

# AGENT_MAILBOX=true connects the agent through the Agentverse mailbox relay.
# This is what lets ASI:One reach the coordinator without a public inbound
# port. Open the Inspector link from the startup log and choose
# Connect -> Mailbox once; the running process then registers itself.
#
# scripts/run_local.py applies this setting to the coordinator only; the
# supplier and outreach agents stay on localhost inside the same host.
AGENT_MAILBOX=false

# Public URL to advertise instead of the local one, for a hosted deployment
# without mailbox mode (for example https://my-host.example.com/submit).
# Leave empty for the local demo. Mutually exclusive with AGENT_MAILBOX=true.
AGENT_ENDPOINT=

# Peer addresses for the coordinator (generated by scripts/init_env.py or
# printed by scripts/print_addresses.py).
SUPPLIER_ADDRESS=
OUTREACH_ADDRESS=

# --- ASI1 LLM (optional; deterministic fallbacks used when empty) ------------
# Endpoint/model per the official ASI:One API quickstart (https://docs.asi1.ai).
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini
ASI1_TIMEOUT_SECONDS=8

# --- Payments ----------------------------------------------------------------
# simulated = file-backed demo ledger, clearly labelled SIMULATED (default).
# testnet   = requires the official FET Payment Protocol integration + RPC.
PAYMENT_MODE=simulated
PAYMENT_NETWORK=simulated
PAYMENT_RPC_URL=
SUPPLIER_WALLET_ADDRESS=wp-demo-supplier-wallet
COORDINATOR_WALLET_ADDRESS=wp-demo-coordinator-wallet
SIMULATED_COORDINATOR_BALANCE_FET=1.0
MAX_TRANSFER_FET=0.2
PER_EVENT_MAX_FET=0.6

# --- Email -------------------------------------------------------------------
# console = write masked delivery records to logs (dev mode, NOT delivered).
#           In this mode the coordinator shows the demo RSVP chat codes in
#           chat so the RSVP step can be demonstrated without a mail server.
# smtp    = real delivery; only allowlisted test recipients may be used, and
#           RSVP links/codes travel only inside the email.
EMAIL_PROVIDER=console
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
ALLOWED_TEST_RECIPIENTS=alice@example.test,bob@example.test

# --- RSVP web service ----------------------------------------------------------
# Public base URL used to build attendee links. For a deployed demo this MUST
# be the public HTTPS URL (for example https://my-demo.onrender.com), otherwise
# invitation links point at localhost and do not work for attendees.
RSVP_BASE_URL=http://localhost:8104
# REQUIRED: random 32+ char secret for token signing (scripts/init_env.py
# generates one).
RSVP_SIGNING_SECRET=
RSVP_TOKEN_TTL_SECONDS=1209600
# Port the RSVP service listens on. Leave empty to use the platform's PORT
# variable (Render/Railway/Fly) and otherwise 8104.
RSVP_PORT=

# --- Behaviour tuning (short values are for TESTS only) ----------------------
QUOTE_TTL_SECONDS=1800
APPROVAL_TTL_SECONDS=900
AGENT_REPLY_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=30
